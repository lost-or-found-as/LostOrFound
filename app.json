{
  "expo": {
    "owner": "lost-or-found-as",
    "name": "Lost or Found",
    "slug": "RepairLostOrFound",
    "icon": "./assets/images/icon.png",
    "scheme": "lostorfound",
    "extra": {
      "eas": {
        "projectId": "42c24037-c853-47ae-bb4c-5208947e1270"
      }
    },
    "android": {
      "package": "com.kjfok.lostorfound",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#CFE9FF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "categories": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "lostorfound"
            }
          ]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAAqPdJr3ISHOXc1d7jXLwZJ1N4acot7FM"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.kjfok.lostorfound",
      "icon": "./assets/images/icon.png",
      "associatedDomains": [],
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "lostorfound"
            ]
          }
        ],
        "NSLocationWhenInUseUsageDescription": "Lost or Found uses your location to help you report where an item was lost or found.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lost or Found uses your location to help you report where an item was lost or found."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.kjfok.lostorfound",
          "enableGooglePay": true
        }
      ],
      "expo-localization",
      "expo-font",
      "react-native-localize",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "lost-or-found-app",
          "organization": "lost-or-found"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563EB"
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
